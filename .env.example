# ===== E-Bike Doctor backend 2.1 – Render → Environment =====
# Never commit real values. Never put any of these into the Android app.

# --- Gemini (required) ---
GEMINI_API_KEY=replace_with_server_secret
# Quality tier (diagnose, camera). Model names below are NOT verified from this dev machine (no key).
# gemini-2.5-flash is kept as the LAST fallback (per the owner the live server uses it; it answered on 2026-11-11).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Fast tier (AI chat, smart-diagnose) – lowest latency
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS_FAST=gemini-3.8-flash,gemini-2.5-flash
# Thinking level (Gemini 3.x). 3.8 Flash supports low/medium/high (NOT minimal). Flash-Lite default: minimal.
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_LEVEL_FAST=minimal
GEMINI_READ_TIMEOUT=60
# Cost estimate (USD per 1M tokens) used for metrics and DAILY_COST_LIMIT_USD – set to your current price list.
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75

# --- Daily AI quota / abuse protection ---
QUOTA_SECRET=generate_a_long_random_string   # e.g. python3 -c "import secrets;print(secrets.token_hex(32))"
DAILY_AI_LIMIT=50
DAILY_IP_LIMIT=300
MAX_REGISTRATIONS_PER_IP=5
DAILY_GLOBAL_LIMIT=5000
DAILY_COST_LIMIT_USD=0          # 0 = off; e.g. 3 = stop AI for the day after ~3 USD estimated spend
QUOTA_TZ=Europe/Budapest
RATE_LIMIT_PER_10_MINUTES=30    # burst protection per IP
TRUST_PROXY_HOPS=1

# --- Persistent counters + cache (strongly recommended on Render free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Answer cache ---
CACHE_ENABLED=1
CACHE_TTL_SECONDS=604800
CACHE_MAX_QUESTION_CHARS=240

# --- Metrics endpoint (/v1/metrics, header X-Admin-Token) ---
ADMIN_TOKEN=generate_another_random_string

# --- Optional fallback ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
