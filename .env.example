# ===== E-Bike Doctor backend 2.1 – Render → Environment =====
# Never commit real values. Never put any of these into the Android app.

# --- Gemini (required) ---
GEMINI_API_KEY=replace_with_server_secret
# Quality tier (diagnose, camera). Model names below are NOT verified from this dev machine (no key).
# gemini-2.5-flash is kept as the LAST fallback (per the owner the live server uses it; it answered on 2026-11-11).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Fast tier (AI chat, smart-diagnose) – lowest latency
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS_FAST=gemini-3.8-flash,gemini-2.5-flash
# Thinking level (Gemini 3.x). 3.8 Flash supports low/medium/high (NOT minimal). Flash-Lite default: minimal.
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_LEVEL_FAST=minimal
GEMINI_READ_TIMEOUT=60
# Cost estimate (USD per 1M tokens) used for metrics and DAILY_COST_LIMIT_USD – set to your current price list.
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75

# --- Daily AI quota / abuse protection ---
QUOTA_SECRET=generate_a_long_random_string   # e.g. python3 -c "import secrets;print(secrets.token_hex(32))"
DAILY_AI_LIMIT=50
DAILY_IP_LIMIT=300
MAX_REGISTRATIONS_PER_IP=5
DAILY_GLOBAL_LIMIT=5000
DAILY_COST_LIMIT_USD=0          # 0 = off; e.g. 3 = stop AI for the day after ~3 USD estimated spend
QUOTA_TZ=Europe/Budapest
RATE_LIMIT_PER_10_MINUTES=30    # burst protection per IP
TRUST_PROXY_HOPS=1

# --- Persistent counters + cache (strongly recommended on Render free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Answer cache ---
CACHE_ENABLED=1
CACHE_TTL_SECONDS=604800
CACHE_MAX_QUESTION_CHARS=240

# --- Metrics endpoint (/v1/metrics, header X-Admin-Token) ---
ADMIN_TOKEN=generate_another_random_string

# --- Optional fallback ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ===== Backend 3.0 – commercial licensing, web shop, cost protection (all OFF / safe by default) =====
# AI access: open = as before (2.x apps keep working) | token = install token required | license = only licence-bound tokens
AI_ACCESS_MODE=open
# The 2.3 Android / 1.1 Windows apps use AI ONLY when this is 1. Set it ONLY after the Gemini paid tier is proven + owner approval.
AI_PUBLIC=0
# Monthly cost cap (USD, 0 = off) + one-time warnings at these % of the daily/monthly caps (e-mail to ADMIN_ALERT_EMAIL)
MONTHLY_COST_LIMIT_USD=0
COST_WARN_LEVELS=50,80,100
ADMIN_ALERT_EMAIL=

# --- Licence server ---
# PEM of C:\EBD_SIGNING\license-server-lease\private key (paste the whole PEM incl. BEGIN/END lines). Without it the
# licence endpoints answer 503 "not_configured". NEVER commit it, never put it into an app.
LEASE_SIGNING_KEY_PEM=
LICENSE_KEY_PEPPER=generate_a_long_random_string
LEASE_DAYS=14
MAX_TRANSFERS_30D=2

# --- Lemon Squeezy (Merchant of Record) ---
SHOP_MODE=test                  # test = only test-mode orders create licences; live = only live orders
LEMONSQUEEZY_WEBHOOK_SECRET=    # the signing secret entered at Settings → Webhooks (events: order_created, order_refunded)
# variant_id (or product_id) → product. Example: {"123456":"EBD-WIN","123457":"EBD-AND"}
LS_PRODUCT_MAP={}
PUBLIC_BASE_URL=https://e-bike-doctor.onrender.com
# Protected download (48 h signed link, only after payment / with a valid licence key)
DOWNLOAD_SECRET=generate_a_long_random_string
DOWNLOAD_URL_EBD_WIN=           # e.g. a private GitHub release asset / storage URL of EBikeDoctorPRO-Setup-1.1.0.exe
DOWNLOAD_URL_EBD_AND=           # URL of EBikeDoctorPRO-2.3.0-web.apk

# --- Purchase e-mails (licence key to the buyer). Without SMTP the mail goes to the redacted outbox only. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ===== Backend 3.1 – automatic mail, private downloads, key re-send, Smart Hardware interest list =====
# Mail via HTTPS API (Render free instances block outbound SMTP ports). One of:
MAIL_PROVIDER=                  # resend | brevo | smtp (empty = automatic by the key that is set)
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=                      # E-Bike Doctor PRO <licenc@your-domain>  (must be a verified sender/domain)
MAIL_REPLY_TO=
SUPPORT_EMAIL=                  # shown in the customer e-mails
# Private download bucket (S3-compatible: Cloudflare R2 / Backblaze B2 / AWS) – pre-signed links, a few minutes valid
DOWNLOAD_S3_ENDPOINT=           # https://<accountid>.r2.cloudflarestorage.com
DOWNLOAD_S3_REGION=auto
DOWNLOAD_S3_BUCKET=
DOWNLOAD_S3_ACCESS_KEY_ID=      # read-only token for this bucket
DOWNLOAD_S3_SECRET_ACCESS_KEY=
DOWNLOAD_OBJECT_EBD_WIN=        # e.g. windows/EBikeDoctorPRO-Setup-1.1.0.exe
DOWNLOAD_OBJECT_EBD_AND=        # e.g. android/EBikeDoctorPRO-2.3.0-web.apk
DOWNLOAD_LINK_SECONDS=300
DOWNLOADS_PER_LICENCE_PER_DAY=10
# Re-send copy of licence keys (AES-GCM). Empty = derived from LICENSE_KEY_PEPPER.
LICENSE_KEY_ENC_SECRET=
# Website forms (comma separated origins). Official domain since 2026-11-14:
# CORS_ORIGINS=https://ebikedoctorpro.com,https://www.ebikedoctorpro.com,https://e-bike-doctor-pro-website.pages.dev
CORS_ORIGINS=
SITE_URL=                       # website links in e-mails and on the confirm/unsubscribe pages (empty = https://ebikedoctorpro.com)
# SITE_HOST=ebikedoctorpro.com,www.ebikedoctorpro.com,e-bike-doctor-pro-website.pages.dev   (own hosts, not counted as referrers)
INTEREST_SECRET=generate_a_long_random_string
# Staging only: separate key namespace in the same Upstash database (production: leave empty!)
STORE_KEY_PREFIX=
